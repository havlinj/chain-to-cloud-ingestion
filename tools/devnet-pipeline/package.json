{
  "name": "devnet-pipeline",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Devnet voting lifecycle CLI for AWS pipeline E2E (commit → reveal → finalize)",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.32.1",
    "@solana/web3.js": "1.95.4",
    "voting-shared": "file:../voting-shared"
  },
  "devDependencies": {
    "@types/node": "22.10.1",
    "prettier": "3.5.3",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
