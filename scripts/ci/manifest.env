# CI manifest — single source of truth for tool versions and package lists.
# Consumed by: scripts/ci/*.sh, .github/actions/ci-toolchains, docs/ci.md
#
# When adding a TypeScript package: append to TS_PACKAGES and add a matrix entry
# in .github/workflows/ci.yml (dynamic matrix — see docs/ci.md § Future improvements).

NODE_VERSION=20
GO_VERSION=1.22
RUST_TOOLCHAIN=1.85.0
TERRAFORM_VERSION=1.10.5

# Space-separated repo-relative paths
TS_PACKAGES="tools/voting-shared services/ingestion tools/eligibility-admin tools/devnet-pipeline"
TF_STACKS="aws gcp"
